# Runtime
DEMO_MODE=true
APP_ENV=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://aegisfire:aegisfire@db:5432/aegisfire

# External data — obtain separately and never commit real values
FIRMS_MAP_KEY=
FIRMS_SOURCE=VIIRS_NOAA20_NRT
FIRMS_DAY_RANGE=1
FIRMS_REQUEST_TIMEOUT_SECONDS=30
FIRMS_ARCHIVE_DIR=data/archive/firms
INDIA_BBOX=[68.0,6.0,98.0,38.0]
INDIA_BOUNDARY_FILE=data/samples/india_adm0_geoboundary.geojson
CLUSTERING_EPSILON_M=750
CLUSTERING_MIN_SAMPLES=2
CLUSTER_REVIEW_FILE=data/cache/cluster_review_audit.json
MODEL_BENCHMARK_REPORT_FILE=data/samples/model_benchmark_report.json
MODEL_MIN_REVIEWED_SAMPLES=60
MODEL_MIN_SAMPLES_PER_CLASS=10
MODEL_MIN_SPATIAL_GROUPS_PER_CLASS=3

# Database container
POSTGRES_DB=aegisfire
POSTGRES_USER=aegisfire
POSTGRES_PASSWORD=aegisfire
